{
    "model": {
        "name": "STID",
        "module": "basicts.models.STID.arch.stid_arch"
    },
    "model_config": {
        "input_len": 144,
        "output_len": 12,
        "num_features": 2500,
        "input_hidden_size": 64,
        "intermediate_size": null,
        "hidden_act": "relu",
        "num_layers": 3,
        "if_spatial": true,
        "spatial_hidden_size": 32,
        "if_time_in_day": true,
        "if_day_in_week": true,
        "num_time_in_day": 144,
        "num_day_in_week": 7,
        "tid_hidden_size": 32,
        "diw_hidden_size": 32
    },
    "dataset_name": "MILAN",
    "gpus": "0",
    "optimizer_params": {
        "lr": 0.001,
        "weight_decay": 0.0005
    },
    "lr_scheduler": {
        "name": "CosineAnnealingLR",
        "module": "torch.optim.lr_scheduler"
    },
    "lr_scheduler_params": {
        "T_max": 100,
        "eta_min": 1e-05
    },
    "seed": 1,
    "num_epochs": 100,
    "callbacks": [
        {
            "name": "EarlyStopping",
            "module": "basicts.runners.callback.early_stopping",
            "params": {}
        },
        {
            "name": "GradientClipping",
            "module": "basicts.runners.callback.clip_grad",
            "params": {
                "max_norm": 5.0
            }
        }
    ],
    "eval_horizons": [
        0,
        5,
        11
    ],
    "save_results": true,
    "ckpt_save_dir": "checkpoints/STID_MILAN/seed1",
    "taskflow": {
        "name": "BasicTSForecastingTaskFlow",
        "module": "basicts.runners.taskflow.forecasting_taskflow",
        "params": {}
    },
    "gpu_num": 1,
    "dataset_type": {
        "name": "BasicTSForecastingDataset",
        "module": "basicts.data.tsf_dataset"
    },
    "dataset_params": {
        "input_len": 144,
        "output_len": 12,
        "use_timestamps": true,
        "memmap": false,
        "dataset_name": "MILAN"
    },
    "null_val": NaN,
    "null_to_num": 0.0,
    "scaler": {
        "name": "ZScoreScaler",
        "module": "basicts.scaler.z_score_scaler"
    },
    "norm_each_channel": true,
    "rescale": false,
    "ddp_find_unused_parameters": false,
    "compile_model": false,
    "metrics": [
        "MAE",
        "MSE",
        "RMSE",
        "MAPE",
        "WAPE"
    ],
    "target_metric": "MAE",
    "best_metric": "min",
    "num_steps": null,
    "loss": "MAE",
    "optimizer": {
        "name": "Adam",
        "module": "torch.optim.adam"
    },
    "ckpt_save_strategy": null,
    "finetune_from": null,
    "strict_load": true,
    "train_batch_size": 32,
    "train_data_prefetch": false,
    "train_data_shuffle": true,
    "train_data_collate_fn": null,
    "train_data_num_workers": 0,
    "train_data_pin_memory": false,
    "val_batch_size": 32,
    "val_interval": 1,
    "val_data_prefetch": false,
    "val_data_shuffle": false,
    "val_data_collate_fn": null,
    "val_data_num_workers": 0,
    "val_data_pin_memory": false,
    "eval_after_train": true,
    "tf32": false,
    "deterministic": false,
    "cudnn_enabled": true,
    "cudnn_benchmark": true,
    "cudnn_determinstic": false,
    "test_batch_size": 32,
    "test_interval": 1,
    "test_data_prefetch": false,
    "test_data_shuffle": false,
    "test_data_collate_fn": null,
    "test_data_num_workers": 0,
    "test_data_pin_memory": false
}